# Academic Research Assistant CLI - Environment Configuration

# Unpaywall API (optional, but recommended for PDF finding)
# Get your free key at: https://unpaywall.org/products/api
UNPAYWALL_EMAIL=your.email@example.com

# CORE API (optional, for extended PDF search)
# Get your key at: https://core.ac.uk/services/api/
CORE_API_KEY=your_core_api_key_here

# Semantic Scholar API (optional, for enhanced citation analysis)
# Free tier available, no key required for basic usage
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex (free, no key required)
# Crossref (free, no key required)
# arXiv (free, no key required)
# Europe PMC (free, no key required)

# Request configuration
REQUEST_TIMEOUT=30
MAX_RETRIES=3
CACHE_ENABLED=true
CACHE_TTL=3600
